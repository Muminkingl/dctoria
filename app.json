{
  "expo": {
    "name": "dctoria",
    "slug": "dctoria",
    "version": "1.0.0",
    "scheme": "dctoria",
    "description": "Your Kurdish healthcare companion. Find doctors, hospitals, clinics, and laboratories.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f7fafb",
    "primaryColor": "#159ac4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trxstudio.dctoria",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.trxstudio.dctoria",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#159ac4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "dctoria",
      "themeColor": "#159ac4"
    },
    "plugins": [
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": [
            "ckb",
            "en"
          ]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#159ac4",
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 160
        }
      ],
      "expo-web-browser"
    ]
  }
}
